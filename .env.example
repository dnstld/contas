# Copy to .env.local and fill in real values (git-ignored). Never commit real secrets.
# Only EXPO_PUBLIC_* vars are inlined into the app bundle at build time.

# Supabase (publishable/anon key — RLS-protected, safe to ship; NOT the service_role key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google OAuth client IDs (from Google Cloud Console)
# Web client ID is passed to GoogleSignin.configure and used by Supabase to validate the ID token.
# The web client *secret* stays server-side in Supabase's provider config — never on-device.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@your-org.ingest.sentry.io/your-project

# Build variant: development | preview | production. Drives Sentry environment at runtime.
# preview/production values are injected by the matching EAS build profile.
EXPO_PUBLIC_APP_VARIANT=development

# SENTRY_AUTH_TOKEN (sourcemap upload) is an EAS environment SECRET — set it in the EAS
# dashboard for preview + production. Do NOT commit it here or add the EXPO_PUBLIC_ prefix.
